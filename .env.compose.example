# Copy to .env.compose.local and replace the local-only values.
POSTGRES_DB=timeyou
POSTGRES_USER=timeyou
POSTGRES_PASSWORD=replace-with-local-password
FOCUS_INTERNAL_API_KEY=replace-with-local-internal-key
CORS_ORIGIN=http://localhost:3001

COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=replace-with-cognito-user-pool-id
COGNITO_APP_CLIENT_ID=replace-with-cognito-app-client-id

NEXT_PUBLIC_COGNITO_ISSUER=https://cognito-idp.eu-central-1.amazonaws.com/replace-with-cognito-user-pool-id
NEXT_PUBLIC_COGNITO_CLIENT_ID=replace-with-cognito-app-client-id
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3001/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ANALYTICS_API_BASE_URL=http://localhost:8001
